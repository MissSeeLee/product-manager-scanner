{
    email {$ACME_EMAIL}
}

{$MANAGER_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        -Server
    }

    reverse_proxy backend:3001
}

{$VIEWER_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @publicApi path /api/public/*
    handle @publicApi {
        @unsafe not method GET HEAD
        respond @unsafe 405
        reverse_proxy backend:3001
    }

    @otherApi path /api/*
    handle @otherApi {
        respond 404
    }

    handle {
        root * /srv/assetops/viewer
        try_files {path} /index.html
        file_server
    }
}
